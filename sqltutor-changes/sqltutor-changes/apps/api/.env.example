# Строка подключения к PostgreSQL
DATABASE_URL=postgresql://sqltutor:sqltutor_dev@localhost:5432/sqltutor

# Секрет для подписи JWT access-токенов
JWT_ACCESS_SECRET=

# --- Telegram-бот ---
# Токен обязателен для запуска API (модуль Telegram инициализируется при старте).
# 1. Создайте бота у @BotFather и получите токен.
# 2. Укажите username бота без «@» — он используется для кнопки
#    «Привязать Telegram» на странице профиля (deep link t.me/<bot>?start=...).
# 3. Пользователь нажимает кнопку на сайте, открывает бота и нажимает
#    «Начать» — аккаунт сайта и Telegram связываются автоматически.
# Если бот не нужен, укажите произвольный токен-заглушку: API запустится,
# но Telegram-функции работать не будут.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
